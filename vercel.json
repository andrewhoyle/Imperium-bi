{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [{ "path": "/api/cron-digest", "schedule": "0 7 * * 1" }],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.imperium-bi.co.uk" }],
      "destination": "https://imperium-bi.co.uk/$1",
      "permanent": true
    }
  ]
}
