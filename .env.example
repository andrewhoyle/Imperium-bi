# Imperium BI site — environment variable names (values live in Vercel, never here).

# PostHog analytics (EU). The project key is public. Leave it empty and no
# analytics load; with it set, PostHog still loads only after a visitor accepts
# analytics cookies in the banner.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
